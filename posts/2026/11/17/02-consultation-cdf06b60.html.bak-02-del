*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--serif);font-size:16px;line-height:1.9;color:var(--ink);background:var(--bg)}
.wrap{max-width:780px;margin:0 auto;padding:60px 24px 90px}
